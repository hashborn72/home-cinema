<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="@color/launcher_background" />
        </shape>
    </item>
    <!-- Preserve the supplied square artwork without stretching it to 16:9. -->
    <item android:width="180dp" android:height="180dp" android:gravity="center">
        <bitmap android:src="@drawable/home_cinema_logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>

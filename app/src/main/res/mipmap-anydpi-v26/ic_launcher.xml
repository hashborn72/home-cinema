<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground>
        <!-- Fit the original artwork inside the adaptive icon's safe area. -->
        <inset android:insetLeft="21dp" android:insetTop="21dp"
            android:insetRight="21dp" android:insetBottom="21dp">
            <bitmap android:src="@drawable/home_cinema_logo" android:gravity="fill" android:filter="true" />
        </inset>
    </foreground>
</adaptive-icon>
